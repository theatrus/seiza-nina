<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately no reference to Seiza.Nina: load it exclusively in NINA's plugin context. -->
    <ProjectReference Include="$(NinaSourcePath)\NINA.Plugin\NINA.Plugin.csproj" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
</Project>
