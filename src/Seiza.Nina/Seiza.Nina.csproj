<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Title>Seiza Plate Solver</Title>
    <Description>Local hinted and blind plate solving with Seiza.</Description>
    <Company>Yann Ramin (@theatrus)</Company>
    <Product>Seiza for N.I.N.A.</Product>
    <Copyright>Copyright (c) 2026 Yann Ramin</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source references are deliberate: the provider API is only available on upstream develop. -->
    <ProjectReference Include="$(NinaSourcePath)\NINA.Plugin\NINA.Plugin.csproj" />
    <InternalsVisibleTo Include="Seiza.Nina.Tests" />
    <None Include="..\..\target\release\seiza_nina_native.dll" Link="seiza_nina_native.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\target\release\seiza_nina_native.dll')" />
  </ItemGroup>
</Project>
