<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Seiza.Nina"
                    x:Class="Seiza.Nina.Options">
    <DataTemplate DataType="{x:Type local:SeizaSolverProvider}">
        <Grid><local:SettingsView DataContext="{Binding Settings}" /></Grid>
    </DataTemplate>
    <DataTemplate x:Key="Seiza Plate Solver_Options">
        <Grid><local:SettingsView DataContext="{Binding Settings}" /></Grid>
    </DataTemplate>
</ResourceDictionary>
